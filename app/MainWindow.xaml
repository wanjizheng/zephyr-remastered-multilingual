<Window x:Class="ZephyrPatcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" Icon="Assets/patcher.ico" Title="西风狂诗曲 · 汉化工具" Width="1040" Height="700" MinWidth="940" MinHeight="680" Background="#F5F6F8" Foreground="#25334A" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#667286"/>
  <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}"><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="16,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="LanguageIcon" TargetType="RadioButton">
   <Setter Property="Width" Value="45"/><Setter Property="Height" Value="39"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#526582"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="IconBorder" Background="#F0F2F6" BorderBrush="#D9E0EA" BorderThickness="1" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="IconBorder" Property="Background" Value="#263B5D"/><Setter TargetName="IconBorder" Property="BorderBrush" Value="#263B5D"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconBorder" Property="BorderBrush" Value="#54719A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <md:DialogHost x:Name="Dialogs" Style="{StaticResource MaterialDesignEmbeddedDialogHost}" CloseOnClickAway="False">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#202E49"><Grid Margin="30,35,30,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/patcher.ico" Width="28" Height="28"/><TextBlock x:Name="SidebarProject" Text="民间汉化计划" Foreground="#C7D2E4" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
    <TextBlock x:Name="SidebarTitle" Text="西风狂诗曲" FontFamily="STZhongsong, SimSun" FontSize="33" Foreground="#F8F5EF" Margin="0,38,0,10"/>
    <TextBlock x:Name="SidebarEdition" Text="重制版多语言翻译" Foreground="#AABAD1" FontSize="14"/>
   </StackPanel>
   <Grid Grid.Row="1" VerticalAlignment="Center" Height="190" IsHitTestVisible="False">
    <Path Stroke="#607491" StrokeThickness="1" Data="M 12,146 C 50,80 148,110 200,24 M 4,159 C 63,110 145,138 208,57 M 15,172 C 94,146 174,158 215,98" Opacity="0.65"/>
    <Path Stroke="#C4A16A" StrokeThickness="2" Fill="#263952" Data="M 55,60 L 105,75 L 155,60 L 155,130 L 105,147 L 55,130 Z M 105,75 L 105,147 M 66,77 L 91,85 M 66,91 L 91,99 M 119,86 L 145,77 M 119,100 L 145,91"/>
   </Grid>
   <StackPanel Grid.Row="2"><TextBlock x:Name="SidebarMotto" Text="让记忆里的冒险&#x0a;再次启程。" FontFamily="STZhongsong, SimSun" Foreground="#F0E6D5" FontSize="23" LineHeight="36"/>
    <Border Height="1" Background="#40506A" Margin="0,23,0,17"/>
    <TextBlock x:Name="SidebarCredit" Text="为爱发电，免费分享。&#x0a;感谢每一位支持正版的冒险者。" Foreground="#AFBED4" FontSize="12" LineHeight="23"/>
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="36,28,36,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="MainHeading" Text="中文，回到熟悉的世界" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="MainSubheading" Text="选择游戏目录，即可安装或恢复。" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="LanguageIconLabel" Text="安装语言" FontSize="12" FontWeight="SemiBold" Foreground="#526582" Margin="0,0,0,6" HorizontalAlignment="Right"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="CnLanguage" GroupName="InstallLanguage" Content="CN" Style="{StaticResource LanguageIcon}" IsChecked="True" Checked="AppLanguageChanged" ToolTip="简体中文 · 安装简体语言包" AutomationProperties.Name="简体中文安装包"/><RadioButton x:Name="TwLanguage" GroupName="InstallLanguage" Content="TW" Style="{StaticResource LanguageIcon}" Checked="AppLanguageChanged" ToolTip="繁體中文 · 安裝繁體語言包" AutomationProperties.Name="繁體中文安裝包"/><RadioButton x:Name="EnLanguage" GroupName="InstallLanguage" Content="EN" Style="{StaticResource LanguageIcon}" Checked="AppLanguageChanged" ToolTip="English · Install English language pack" AutomationProperties.Name="English language pack"/></StackPanel><Border HorizontalAlignment="Right" Margin="0,9,6,0" CornerRadius="5" Background="#E6EAF1" Padding="10,5"><TextBlock x:Name="VersionBadge" Text="v0.4.6" Foreground="#526582" FontSize="11"/></Border></StackPanel>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,29,0,0"><TextBlock x:Name="GameDirectoryLabel" Text="游戏目录" FontWeight="SemiBold" Margin="0,0,0,9"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="GamePath" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="12" Padding="12,14" VerticalContentAlignment="Center" TextChanged="PathChanged" AutomationProperties.Name="游戏安装目录" ToolTip="选择包含 ZephyrRemastered.exe 的文件夹"/>
     <Button x:Name="BrowseButton" Grid.Column="1" Margin="10,0,0,0" Height="50" Click="BrowseClick" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="选择游戏文件夹"><md:PackIcon Kind="FolderOpenOutline" Width="22" Height="22"/></Button>
    </Grid>
    <TextBlock x:Name="BuildInfo" Text="游戏 Build：未识别   ·   支持 Build：25418345" FontSize="11" Foreground="{StaticResource Muted}" Margin="1,8,0,0"/>
   </StackPanel>
   <Border Grid.Row="2" Background="White" BorderBrush="#E0E5ED" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,22,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="StateIconBackground" Background="#E6ECF5" CornerRadius="24" Width="46" Height="46" VerticalAlignment="Top"><md:PackIcon x:Name="StateIcon" Kind="FolderSearchOutline" Foreground="#456080" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1" Margin="15,0,0,0"><TextBlock x:Name="StateTitle" Text="等待选择游戏目录" FontWeight="SemiBold" FontSize="17" Margin="0,1,0,7"/><TextBlock x:Name="StateDetail" Text="找到游戏后，会先检查文件兼容性与备份状态。" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="22"/></StackPanel>
    </Grid>
   </Border>
   <StackPanel Grid.Row="3" Margin="0,16,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="InstallButton" Style="{StaticResource MaterialDesignRaisedButton}" Content="安装汉化" Height="52" FontSize="16" FontWeight="SemiBold" Click="InstallClick" IsEnabled="False" md:ButtonAssist.CornerRadius="7"/>
     <Button x:Name="RestoreButton" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}" Content="通过 Steam 恢复" Height="52" FontSize="14" Margin="12,0,0,0" Padding="25,0" Click="RestoreClick" IsEnabled="False" md:ButtonAssist.CornerRadius="7"/>
    </Grid>
    <Button x:Name="RecoverButton" Content="修复中断的安装" HorizontalAlignment="Left" Visibility="Collapsed" Click="RecoverClick" Margin="0,10,0,0"/>
    <TextBlock x:Name="BackupInfo" Text="" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
    <ProgressBar x:Name="Progress" Height="4" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
    <TextBlock x:Name="ProgressText" Text="安装前自动备份；恢复原版请使用 Steam。存档不受影响。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="21"/>
    <StackPanel x:Name="FeatureRow" Orientation="Horizontal" Margin="0,12,0,0"><md:PackIcon Kind="ShieldCheckOutline" Width="17" Height="17" Foreground="#8A713F"/><TextBlock x:Name="FeatureText" Text="保留原版美术字    /    朱雀仿宋    /    离线安装" FontSize="11" Foreground="#727C8A" Margin="7,0,0,0"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Row="4"><Border Height="1" Background="#E0E5ED" Margin="0,13,0,9"/><Grid><StackPanel Orientation="Horizontal" Margin="-12,0,0,0"><Button x:Name="UpdateButton" Content="检查更新" Click="CheckUpdateClick"/><Button x:Name="RecheckButton" Content="重新检测" Click="RecheckClick"/><Button x:Name="ProofreaderButton" Content="对白校对" Click="ProofreaderClick"/><Button x:Name="FeedbackButton" Content="问题反馈" Click="FeedbackClick"/><Button x:Name="StoreButton" Content="支持正版" Click="StoreClick"/></StackPanel></Grid>
    <Grid Margin="2,4,0,0"><TextBlock x:Name="FooterVersion" Text="v0.4.6 · 非官方汉化工具" FontSize="11" Foreground="#7A8595"/><TextBlock x:Name="UpdateStatus" Text="" HorizontalAlignment="Right" FontSize="11" Foreground="#7A8595"/></Grid>
   </StackPanel>
  </Grid>
 </Grid>
 </md:DialogHost>
</Window>
